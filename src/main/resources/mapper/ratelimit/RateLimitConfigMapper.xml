<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.ai.gateway.repository.ratelimit.RateLimitConfigMapper">

    <!-- ResultMap -->
    <resultMap id="BaseResultMap" type="com.bank.ai.gateway.model.entity.ratelimit.RateLimitConfig">
        <id column="id" property="id"/>
        <result column="dimension" property="dimension"/>
        <result column="dimension_value" property="dimensionValue"/>
        <result column="limit_value" property="limitValue"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, dimension, dimension_value, limit_value, enabled, created_at, updated_at
    </sql>

    <!-- 根据维度查询配置 -->
    <select id="findByDimension" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM rate_limit_config
        WHERE dimension = #{dimension}
          AND dimension_value = #{dimensionValue}
          AND enabled = 1
        LIMIT 1
    </select>

    <!-- 查询所有启用的配置 -->
    <select id="findAllEnabled" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM rate_limit_config
        WHERE enabled = 1
    </select>

</mapper>
